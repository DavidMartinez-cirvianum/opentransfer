# OpenTransfer instance configuration.
# Copy to /etc/opentransfer/instance.env and protect it with chmod 600.
# Do not commit real passwords, tokens or encryption keys.

OT_LISTEN_ADDR=127.0.0.1:8080
OT_PUBLIC_URL=https://files.example.com
OT_LOG_LEVEL=info

# PostgreSQL URL. In Docker Compose use host "database".
OT_DATABASE_URL=postgres://opentransfer:CHANGE_ME@database:5432/opentransfer?sslmode=disable
POSTGRES_DB=opentransfer
POSTGRES_USER=opentransfer
POSTGRES_PASSWORD=CHANGE_ME
OT_POSTGRES_DATA_DIR=/var/lib/opentransfer/postgres

# local = local filesystem; nas = an NFS/SMB mount already mounted by the host.
OT_STORAGE_BACKEND=local
OT_STORAGE_LOCAL_PATH=/var/lib/opentransfer/files

# Generate with: openssl rand -base64 32
OT_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Docker host publishing. Keep 127.0.0.1 when using a local reverse proxy.
OT_BIND_ADDRESS=127.0.0.1
OT_HTTP_PORT=8080
