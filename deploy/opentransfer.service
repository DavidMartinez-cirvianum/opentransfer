[Unit]
Description=OpenTransfer self-hosted file transfer service
Documentation=https://github.com/DavidMartinez-cirvianum/opentransfer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opentransfer
Group=opentransfer
EnvironmentFile=/etc/opentransfer/instance.env
WorkingDirectory=/opt/opentransfer/current
ExecStart=/opt/opentransfer/current/bin/opentransfer
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/opentransfer
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
